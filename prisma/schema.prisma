generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(cuid())
  name       String?
  age        Int?
  bio        String?
  image      String?
  createdAt  DateTime   @default(now())
  apiKey     ApiKey?
  categories Category[]
  feeds      Feeds[]
  readState  ReadState[]
}

model ApiKey {
  id         String    @id @default(cuid())
  keyHash    String    @unique
  label      String    @default("device-key")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Feeds {
  id         String         @id @default(cuid())
  userId     String
  feed_url   String
  name       String?
  categories FeedCategory[]
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id     String         @id @default(cuid())
  name   String
  userId String
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  feeds  FeedCategory[]

  @@unique([userId, name])
}

model FeedCategory {
  feedId     String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  feed       Feeds    @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@id([feedId, categoryId])
}

model FeedCache {
  userId        String
  feedId        String
  name          String?
  source        String
  items         String
  lastFetchedAt DateTime
  updatedAt     DateTime @updatedAt

  @@id([userId, feedId])
}

// Read/unread state for feed items (issue #60).
//
// Item ids are stable, feed-scoped strings produced by the links route
// (`<feedId>::<link|guid|title>`), so they are safe as a plain-text key.
// A row's presence = "read" (readAt is when it was marked). Deleting the
// row = unread.
//
// Local-cache only (ADR-002): read-state is convenience metadata, not
// authored content. Deleting the backend loses read-state, nothing else.
// Portability to the pod is a P2/M4 concern.
model ReadState {
  userId String
  itemId String
  readAt DateTime @default(now())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}
