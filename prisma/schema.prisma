// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Single local user (this app lives on one device, one person).
model User {
  id        String    @id @default(cuid())
  name      String?
  age       Int?
  bio       String?
  image     String?
  createdAt DateTime  @default(now())
  apiKey    ApiKey?
  feeds     Feeds[]
  categories Category[]
}

// A locally-generated private key. The raw key only ever exists on the
// device; the server stores its SHA-256 hash. First key ever registered
// on this database becomes the user's key (registration happens on
// first unlock, no sign-up step).
model ApiKey {
  id         String    @id @default(cuid())
  keyHash    String    @unique
  label      String    @default("device-key")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Feeds {
  id       String @id @default(cuid())
  userId   String
  feed_url String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories FeedCategory[]
}

// A category a user assigns to their feeds (e.g. "tech", "sports").
// Used to sort/filter the aggregated everything-feed on the My Feed page.
model Category {
  id     String @id @default(cuid())
  name   String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  feeds  FeedCategory[]

  @@unique([userId, name])
}

// Join table: one feed may belong to multiple categories.
model FeedCategory {
  feedId     String
  categoryId String
  feed       Feeds    @relation(fields: [feedId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([feedId, categoryId])
}
